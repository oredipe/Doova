# Copy to .env.local for local work. On Vercel, add these in Project → Settings → Environment Variables.
# Never commit real keys.

# Supabase → Project Settings → API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only: never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_...

# Supabase → Authentication → Hooks → "Send SMS hook" (HTTPS) → secret
SUPABASE_SMS_HOOK_SECRET=v1,whsec_...

# Termii (SMS). Leave empty until the account is set up; use Supabase test phone numbers meanwhile.
TERMII_API_KEY=
TERMII_SENDER_ID=
# TERMII_BASE_URL=https://v3.api.termii.com
